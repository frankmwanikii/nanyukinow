APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Hide the public site until visitors open /nn-dev-preview once.
# Admin → Settings → Site access can override this without editing .env.
SITE_PREVIEW_GATE=true
SITE_PREVIEW_PATH=nn-dev-preview

# Staff console URL prefix (login at /{ADMIN_PATH}/login). Use a non-guessable
# value in production. Letters, numbers, and hyphens only. Default: admin
ADMIN_PATH=admin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Shared hosting (cPanel): use database sessions + file/database cache. No Redis required.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.nanyukinow.co.ke
MAIL_PORT=465
MAIL_USERNAME=info@nanyukinow.co.ke
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@nanyukinow.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps JavaScript API (optional fallback; prefer Admin → Settings → Maps)
# Public browser key; restrict by HTTP referrer in Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
# Enable in Google Cloud: Maps JavaScript API + Places API (+ billing on the project)

# Foursquare Places API (server-side only; prefer Admin → Settings → Maps)
FOURSQUARE_API_KEY=
# FOURSQUARE_API_VERSION=2025-06-17

# Google reCAPTCHA v2 checkbox (site key is public; keep secret on the server)
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Nyuki AI (Gemini). Keep the key server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mobitech Bulk SMS (https://bulk.mobitechtechnologies.com/dev/sms)
MOBITECH_SMS_API_KEY=
MOBITECH_SMS_SENDER_NAME=NanyukiNow
MOBITECH_SMS_SERVICE_ID=0
MOBITECH_SMS_BASE_URL=https://api.mobitechtechnologies.com
